# Supabase browser-safe project configuration.
# Use the publishable key when available; legacy anon keys remain supported by Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional deployment metadata exposed only through safe health output.
APP_VERSION=local
LOG_LEVEL=info
